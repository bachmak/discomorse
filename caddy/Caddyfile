{$DOMAIN} {
	handle_path /api/* {
		# The decoder streams application/x-ndjson, which Caddy's stock encode
		# matcher does not list, so the largest response on the site would go
		# out uncompressed unless it is named here.
		encode zstd gzip {
			match {
				header Content-Type application/x-ndjson*
			}
			minimum_length 1
		}
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}
	handle {
		encode zstd gzip
		reverse_proxy frontend:8080
	}
}
